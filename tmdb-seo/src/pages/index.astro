---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getTopMovies, searchMovies } from '../lib/db';
import { getCanonicalUrl, getEnv, posterUrl, truncateMeta } from '../lib/site';

const env = getEnv(Astro.locals);
const searchQuery = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const isSearch = searchQuery.length >= 3;
const movies = isSearch ? await searchMovies(env.DB, searchQuery, 60) : await getTopMovies(env.DB, 60);
const title = `Where to Watch Movies Online - Streaming Guide`;
const description = truncateMeta(
  'Find where movies are streaming, available to rent, or available to buy across major platforms.'
);
const canonical = getCanonicalUrl(Astro.request, '/', env);

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=3600, stale-while-revalidate=86400'
);
---

<Layout title={title} description={description} canonical={canonical}>
  <main>
    <p class="eyebrow">Fresh streaming availability by region</p>
    <h1>Where to Watch Movies Online</h1>
    <p>
      Start with popular movies, then use each page to find current streaming,
      rent, and buy links for your region.
    </p>

    <section class="home-search" aria-labelledby="movie-search-heading">
      <h2 id="movie-search-heading">Find a Movie</h2>
      <form class="search-form" action="/" method="get" role="search" data-movie-search>
        <label for="movie-search">Movie title</label>
        <div class="search-row">
          <input
            id="movie-search"
            name="q"
            type="search"
            value={searchQuery}
            placeholder="Search Avatar, Inception, The Matrix"
            autocomplete="off"
            minlength="3"
            aria-autocomplete="list"
            aria-controls="movie-search-suggestions"
            aria-expanded="false"
            data-search-input
          />
          <button type="submit">Search</button>
        </div>
        <ul
          id="movie-search-suggestions"
          class="search-suggestions"
          role="listbox"
          hidden
          data-search-suggestions
        ></ul>
        <p class="search-help" data-search-status>
          Type at least 3 letters for movie suggestions.
        </p>
      </form>
    </section>

    <h2>{isSearch ? `Search Results for "${searchQuery}"` : 'Popular Movies'}</h2>
    {isSearch && movies.length === 0 && (
      <p class="notice">No movies matched that search. Try another title.</p>
    )}

    <ul class="movie-list">
      {movies.map((movie) => (
        <li class="movie-card">
          <a href={`/movie/${movie.slug}`}>
            {movie.poster_path ? (
              <img
                src={posterUrl(movie.poster_path, 'w342')}
                alt={`${movie.title} poster`}
                width="342"
                height="513"
                loading="lazy"
              />
            ) : (
              <span class="poster-placeholder" aria-hidden="true"></span>
            )}
            <strong>{movie.title}</strong>
          </a>
          <div class="badge-row">
            {movie.release_date && <span class="badge">{String(movie.release_date).slice(0, 4)}</span>}
            {movie.vote_average && <span class="badge">{Number(movie.vote_average).toFixed(1)}/10</span>}
          </div>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<script>
  interface MovieSuggestion {
    title: string;
    slug: string;
    year: string | null;
    rating: string | null;
    poster: string | null;
  }

  const form = document.querySelector('[data-movie-search]') as HTMLFormElement | null;
  const input = form?.querySelector('[data-search-input]') as HTMLInputElement | null;
  const suggestions = form?.querySelector('[data-search-suggestions]') as HTMLUListElement | null;
  const status = form?.querySelector('[data-search-status]') as HTMLElement | null;

  if (form && input && suggestions && status) {
    let controller: AbortController | null = null;
    let debounceTimer: number | undefined;
    let currentSuggestions: MovieSuggestion[] = [];

    const closeSuggestions = () => {
      suggestions.hidden = true;
      suggestions.replaceChildren();
      input.setAttribute('aria-expanded', 'false');
    };

    const renderSuggestions = (results: MovieSuggestion[]) => {
      currentSuggestions = results;
      suggestions.replaceChildren();

      if (!results.length) {
        closeSuggestions();
        status.textContent = 'No suggestions found yet.';
        return;
      }

      for (const movie of results) {
        const item = document.createElement('li');
        item.setAttribute('role', 'option');

        const link = document.createElement('a');
        link.href = `/movie/${movie.slug}`;

        if (movie.poster) {
          const image = document.createElement('img');
          image.src = movie.poster;
          image.alt = '';
          image.width = 46;
          image.height = 69;
          image.loading = 'lazy';
          link.appendChild(image);
        }

        const text = document.createElement('span');
        const title = document.createElement('strong');
        title.textContent = movie.title;
        text.appendChild(title);

        const details = [movie.year, movie.rating ? `${movie.rating}/10` : null]
          .filter(Boolean)
          .join(' / ');
        if (details) {
          const meta = document.createElement('small');
          meta.textContent = details;
          text.appendChild(meta);
        }

        link.appendChild(text);
        item.appendChild(link);
        suggestions.appendChild(item);
      }

      suggestions.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      status.textContent = `${results.length} suggestion${results.length === 1 ? '' : 's'} found.`;
    };

    const fetchSuggestions = async (query: string) => {
      controller?.abort();
      controller = new AbortController();
      status.textContent = 'Searching...';

      try {
        const response = await fetch(`/api/search?q=${encodeURIComponent(query)}`, {
          headers: { Accept: 'application/json' },
          signal: controller.signal,
        });
        if (!response.ok) throw new Error('Search request failed');

        const payload = (await response.json()) as { results?: MovieSuggestion[] };
        renderSuggestions(payload.results ?? []);
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        closeSuggestions();
        status.textContent = 'Search is unavailable right now.';
      }
    };

    input.addEventListener('input', () => {
      const query = input.value.trim();
      window.clearTimeout(debounceTimer);

      if (query.length < 3) {
        controller?.abort();
        currentSuggestions = [];
        closeSuggestions();
        status.textContent = 'Type at least 3 letters for movie suggestions.';
        return;
      }

      debounceTimer = window.setTimeout(() => {
        fetchSuggestions(query);
      }, 180);
    });

    form.addEventListener('submit', (event) => {
      const query = input.value.trim();
      if (query.length < 3) {
        event.preventDefault();
        closeSuggestions();
        status.textContent = 'Enter at least 3 letters to search.';
        input.focus();
        return;
      }

      const exactMatch = currentSuggestions.find(
        (movie) => movie.title.toLowerCase() === query.toLowerCase()
      );
      if (exactMatch) {
        event.preventDefault();
        window.location.assign(`/movie/${exactMatch.slug}`);
      }
    });

    document.addEventListener('click', (event) => {
      if (!form.contains(event.target as Node)) closeSuggestions();
    });
  }
</script>

<style>
  .home-search {
    margin: 30px 0 18px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .home-search h2 {
    margin-top: 0;
  }

  .search-form {
    position: relative;
    max-width: 720px;
  }

  .search-form label {
    display: block;
    margin-bottom: 8px;
    font-weight: 800;
  }

  .search-row {
    display: flex;
    gap: 10px;
  }

  .search-row input {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    padding: 10px 12px;
    font: inherit;
  }

  .search-row button {
    min-height: 48px;
    border: 1px solid var(--accent);
    border-radius: 8px;
    background: var(--accent);
    color: #ffffff;
    padding: 10px 16px;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .search-row button:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .search-suggestions {
    position: absolute;
    z-index: 10;
    width: 100%;
    max-height: 360px;
    overflow: auto;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .search-suggestions a {
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--text);
    padding: 10px;
    text-decoration: none;
  }

  .search-suggestions a:hover,
  .search-suggestions a:focus {
    background: #eef8f9;
  }

  .search-suggestions img {
    width: 46px;
    height: 69px;
    flex: 0 0 auto;
    border-radius: 6px;
    object-fit: cover;
    background: var(--line);
  }

  .search-suggestions span,
  .search-suggestions strong,
  .search-suggestions small {
    display: block;
    overflow-wrap: anywhere;
  }

  .search-suggestions small,
  .search-help {
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .search-row {
      flex-direction: column;
    }

    .search-row button {
      width: 100%;
    }
  }
</style>
